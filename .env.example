# Generate each with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=
PUBLIC_SITE_URL=https://eurofoam.in

# Optional — only load after the visitor allows "Ads and offers"
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase Postgres (self-hosted). Leave empty to use files in data/.
# From inside Docker, the host machine is host.docker.internal.
# Same database + user as NAMS (Supabase pooler, session mode):
DATABASE_URL=postgresql://postgres.supatenant:YOUR_DB_PASSWORD@host.docker.internal:55005/postgres
DATABASE_SSL=false
