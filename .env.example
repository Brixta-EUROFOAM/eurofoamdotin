# # Generate each with: openssl rand -hex 32
# ADMIN_SESSION_SECRET=
# CUSTOMER_SESSION_SECRET=
# PUBLIC_SITE_URL=https://gadda.store

# # GTM-P2KKR8HJ is the built-in public Google Tag Manager container ID.
# # Google Tag Manager loads only after analytics consent. Override if needed:
# NEXT_PUBLIC_GTM_ID=GTM-P2KKR8HJ
# # Optional Meta Pixel, loaded only with separate Ads and offers consent:
# NEXT_PUBLIC_META_PIXEL_ID=

# # Supabase Postgres (self-hosted). Leave empty to use files in data/.
# # From inside Docker, the host machine is host.docker.internal.
# # Same database + user as NAMS (Supabase pooler, session mode):
# DATABASE_URL=postgresql://postgres.supatenant:YOUR_DB_PASSWORD@host.docker.internal:55005/postgres
# DATABASE_SSL=false

# # Razorpay Standard Checkout at the storefront; existing Payment Links remain available to staff.
# Leave keys empty to offer only pay on delivery.
# # Test keys (rzp_test_…) work before KYC; switch to live keys (rzp_live_…) after activation.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# # Any long random string; type the same one when adding the webhook in the Razorpay Dashboard
# RAZORPAY_WEBHOOK_SECRET=

# Cloudflare Turnstile (optional, RUNTIME settings, no NEXT_PUBLIC build injection)
# TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
# TURNSTILE_SECRET_KEY=YOUR_PRIVATE_SECRET
# TURNSTILE_ENFORCE=false  # Set true ONLY after end-to-end checkout tests

# GADDA transactional notifications: Brevo (requires a verified sender/domain)
# BREVO_API_KEY=
# GADDA_ALERT_FROM=orders@gadda.store
# GADDA_ALERT_TO=admin@eurofoam.in

# Optional: Cloudflare Web Analytics site token; explicit analytics consent required.
# Disable duplicate automatic Cloudflare beacon injection when enabled.
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
